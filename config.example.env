# raspy settings – example. Normally you don't edit this by hand:
#   ./install.sh  (or: venv/bin/python app/configure.py) asks for everything and writes config.env.
# To set it up manually: cp config.example.env config.env && chmod 600 config.env

# ── WebUntis ──
# UNTIS_CLASS is the class name; its ID is looked up automatically (IDs change every school year).
# UNTIS_CLASS_ID only if you need to force a fixed ID. DUTY_LABEL = class duty shown on /heute
# (as named in Untis; empty = hide).
UNTIS_SERVER=""
UNTIS_SCHOOL=""
UNTIS_USER=""
UNTIS_PASSWORD=""
UNTIS_CLASS=""
UNTIS_CLASS_ID=""
DUTY_LABEL=Klassenordner

# ── Calendar (optional) ──
# Secret iCal address (Google/iCloud/Outlook). Empty = two-column layout without calendar.
CALENDAR_ICS_URL=""

# ── Weather (optional, Open-Meteo, no API key) ──
# Empty = no weather.
WEATHER_LAT=""
WEATHER_LON=""
WEATHER_PLACE=""

# ── Screen schedule (device/screen_schedule.sh) ──
# SCREEN_SCHEDULE=1: on ON_DAYS (1 = Mon … 7 = Sun) between FROM and UNTIL (HHMM) the screen stays on;
# otherwise off after IDLE_OFF seconds without a button press. SCREEN_SCHEDULE=0: the screen is always on.
SCREEN_SCHEDULE=1
SCREEN_ON_DAYS=12345
SCREEN_ON_FROM=0730
SCREEN_ON_UNTIL=1600
SCREEN_IDLE_OFF=600

# ── Display (see docs/hardware.md) ──
# The pages scale to any screen by themselves. Empty = leave it as the system has it.
# OUTPUT e.g. HDMI-1 (empty = first connected), RESOLUTION e.g. 1920x1080 or 1280x720@60,
# ROTATE 0/90/180/270 degrees clockwise, MARGIN in % against overscan on TVs (0–20),
# BROWSER_FLAGS extra Chromium options, e.g. --disable-gpu.
DISPLAY_OUTPUT=""
DISPLAY_RESOLUTION=""
DISPLAY_ROTATE=""
DISPLAY_MARGIN=0
BROWSER_FLAGS=""

# ── Buttons (only with the buttons extra, see docs/hardware.md) ──
# BCM GPIO numbers (empty = no such button). WIRING: gnd (button to GND), 3v3 (button to 3.3 V),
# active-low / active-high (modules with their own resistor). Times in seconds; MIN_PRESS: shorter
# presses are ignored as noise (raise it with long cables).
BUTTON_TAB_GPIO=17
BUTTON_POWER_GPIO=27
BUTTON_WIRING=gnd
BUTTON_TAB_HOLD=3
BUTTON_POWER_HOLD=4
BUTTON_COMBO_HOLD=2
BUTTON_MIN_PRESS=0.05

# ── Overheat protection + fan (only with that extra, see docs/hardware.md) ──
# Shutdown countdown after CRIT °C for CRIT_SECONDS (right away from PANIC), cancelled below ABORT.
# FAN_CURVE: °C:PWM pairs (PWM 0–255). FAN_HWMON: name of the fan in /sys/class/hwmon/*/name
# (Pi 5 Active Cooler: pwmfan). FAN_MAX_RPM: scale of the speed chart in the system dashboard.
THERMAL_SENSOR=/sys/class/thermal/thermal_zone0/temp
THERMAL_WARN=75
THERMAL_CRIT=85
THERMAL_CRIT_SECONDS=10
THERMAL_PANIC=90
THERMAL_ABORT=82
THERMAL_COUNTDOWN=20
FAN_CURVE="45:0 50:55 60:70 68:100 73:120 77:150 80:200 83:255"
FAN_HWMON=pwmfan
FAN_MAX_RPM=9200

# ── Software watchdog (only with the watchdog extra) ──
# GUARD_WINDOWS: when released versions may be installed, e.g. "Di,Do 11:35-11:50; Mo-Fr 16:15-18:00"
# (empty = only with: sudo raspy-guard update-now). GUARD_APT=1: system updates in the same windows.
GUARD_WINDOWS=""
GUARD_APT=0

# ── Web server ──
# PORT of the web server.
# LAN_ACCESS=1: pages also reachable from other devices (no login – only on a network you trust).
# STATUS_FILE: optional file another program writes a short notice into (JSON {"message": …,
# "updated": unix time} or plain text); shown in the status line of /heute while it is fresh.
PORT=5000
LAN_ACCESS=0
STATUS_FILE=""
